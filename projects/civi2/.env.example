# CivicPilot environment configuration
#
# Copy this file to `.env` and fill in real values. Do not commit `.env` or
# real credentials to version control.

# --- Scheduler concurrency limits (Requirement 23.1-23.5) ---------------
# Each value must be an integer in [1, 32]. An unset variable uses its
# documented default. An out-of-range or non-integer value is rejected at
# startup: the System falls back to the default and logs a startup warning
# naming the invalid variable (the System still starts).

# Maximum concurrent Search_Tool (Tavily) operations. Default: 4
MAX_SEARCH_CONCURRENCY=4

# Maximum concurrent Fetch_Tool (Jina Reader) operations. Default: 4
MAX_FETCH_CONCURRENCY=4

# Maximum concurrent scheme-verification operations. Default: 3
MAX_VERIFY_CONCURRENCY=3

# --- Fast_Model provider configuration (Requirement 6.3-6.5, 6.8) -------
# Used for profile extraction, classification, filtering, dedup, and
# routing. All three variables are required; startup fails with a
# role-identifying error if any is missing or empty.

# Model identifier as recognized by the provider, e.g. "gpt-4o-mini"
FAST_MODEL_NAME=

# Provider API endpoint (base URL)
FAST_MODEL_ENDPOINT=

# Auth credential (API key) for the Fast_Model provider
FAST_MODEL_API_KEY=

# --- Reasoning_Model provider configuration (Requirement 6.3-6.5, 6.8) --
# Used for planning, eligibility reasoning, conflict resolution, and final
# verification. All three variables are required; startup fails with a
# role-identifying error if any is missing or empty.

# Model identifier as recognized by the provider, e.g. "gpt-4o"
REASONING_MODEL_NAME=

# Provider API endpoint (base URL)
REASONING_MODEL_ENDPOINT=

# Auth credential (API key) for the Reasoning_Model provider
REASONING_MODEL_API_KEY=
